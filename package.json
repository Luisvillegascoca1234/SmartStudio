{
  "name": "smartstudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=9.15.4"
  },
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"vite\" \"tsx watch src/server/start.ts\"",
    "build": "vite build",
    "start": "tsx src/server/start.ts",
    "setup:vision": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-vision-models.ps1",
    "qa:fondo": "tsx scripts/validate-backdrop-dataset.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.2",
    "@fontsource-variable/geist": "^5.3.0",
    "ag-psd": "31.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exifreader": "4.41.3",
    "fastify": "5.11.0",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.1",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  },
  "packageManager": "pnpm@9.15.4"
}
